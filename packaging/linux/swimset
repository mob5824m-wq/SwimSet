#!/bin/sh
# SwimSet launcher
# Serves the bundled app on a random localhost port and opens it in a browser
# window (Chrome/Chromium app mode when available). The service worker keeps
# the app usable offline once the window is open.
set -eu

APP_DIR="${SWIMSET_APP_DIR:-/usr/share/swimset}"

if [ ! -f "$APP_DIR/index.html" ]; then
  echo "SwimSet: app files not found in $APP_DIR" >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "SwimSet needs python3 to serve its files. Install it with:" >&2
  echo "  sudo apt install python3" >&2
  exit 1
fi

# Ask the OS for a free port on the loopback interface.
PORT=$(python3 -c 'import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()')

python3 -m http.server "$PORT" --bind 127.0.0.1 --directory "$APP_DIR" >/dev/null 2>&1 &
SERVER_PID=$!

cleanup() {
  kill "$SERVER_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Wait until the local server answers (up to ~5 s).
python3 - "$PORT" <<'PY' || { echo "SwimSet: local server failed to start" >&2; exit 1; }
import sys
import time
import urllib.request

port = sys.argv[1]
for _ in range(50):
    try:
        urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=0.5).read(1)
        sys.exit(0)
    except Exception:
        time.sleep(0.1)
sys.exit(1)
PY

URL="http://127.0.0.1:$PORT/"
PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/swimset/browser-profile"
mkdir -p "$PROFILE"

for browser in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge brave-browser; do
  if command -v "$browser" >/dev/null 2>&1; then
    "$browser" \
      --app="$URL" \
      --user-data-dir="$PROFILE" \
      --no-first-run \
      --no-default-browser-check \
      --class=SwimSet \
      >/dev/null 2>&1 &
    BROWSER_PID=$!
    # Keep the local server alive for as long as the app window is open.
    wait "$BROWSER_PID" 2>/dev/null || true
    exit 0
  fi
done

# No Chromium-style browser: fall back to the default browser and keep serving.
xdg-open "$URL" >/dev/null 2>&1 &
echo "SwimSet is running at $URL"
echo "Close this terminal or press Ctrl+C to stop."
wait "$SERVER_PID"
